<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rakesh Designs - Promotions</title>

    <link rel="stylesheet" href="styles.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

    <!-- Header -->
    <header class="header">

        <div class="logo">
            <a href="index.html">RAKESH DESIGNS</a>
        </div>

        <nav class="navbar">

            <a href="index.html">Home</a>

            <a href="aboutus.html">About Us</a>

            <div class="dropdown">
                <a href="#">
                    Collections <i class="fa-solid fa-chevron-down"></i>
                </a>

                <div class="dropdown-menu">
                    <a href="tshirts.html">T-Shirts</a>
                    <a href="jackets.html">Jackets</a>
                    <a href="jeans.html">Jeans</a>
                    <a href="shoes.html">Shoes</a>
                    <a href="accessories.html">Accessories</a>
                    <a href="bags.html">Bags</a>
                </div>
            </div>

            <a href="salesandoffers.html">Sales & Offers</a>

            <div class="dropdown">
                <a href="#">
                    Men <i class="fa-solid fa-chevron-down"></i>
                </a>

                <div class="dropdown-menu">
                    <a href="menshoes.html">Men's Shoes</a>
                    <a href="menclothing.html">Men's Clothing</a>
                    <a href="menaccessories.html">Men's Accessories</a>
                    <a href="mennewarrivals.html">Men's New Arrivals</a>
                </div>
            </div>

            <div class="dropdown">
                <a href="#">
                    Women <i class="fa-solid fa-chevron-down"></i>
                </a>

                <div class="dropdown-menu">
                    <a href="womenshoes.html">Women's Shoes</a>
                    <a href="womenclothing.html">Women's Clothing</a>
                    <a href="womenaccessories.html">Women's Accessories</a>
                    <a href="womennewarrivals.html">Women's New Arrivals</a>
                </div>
            </div>

            <a href="contactus.html">Contact Us</a>

        </nav>

        <div class="header-icons">

            <i class="fa-solid fa-magnifying-glass" id="searchIcon"></i>

            <i class="fa-regular fa-user"></i>

            <i class="fa-solid fa-bag-shopping"></i>

            <i class="fa-solid fa-bars" id="menuIcon"></i>

        </div>

        <!-- Search Box -->
        <div class="search-box" id="searchBox">

            <input type="text"
                id="searchInput"
                placeholder="Search products...">

            <button id="searchButton">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>

        </div>

    </header>


    <!-- Page Banner -->
    <section class="page-banner">

        <div class="page-banner-content">

            <h1>Promotions</h1>

            <div class="breadcrumb">
                <a href="index.html">Home</a>
                <span>/</span>
                <span>Promotions</span>
            </div>

        </div>

    </section>


    <!-- Main Promotion Section -->
    <section class="products-section">

        <div class="section-title">

            <h2>Exclusive Promotions</h2>

            <p>
                Enjoy amazing deals, special discounts and
                exclusive offers from Rakesh Designs.
            </p>

        </div>


        <!-- Promotion Cards -->
        <div class="product-grid">


            <!-- Promotion 1 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="images/promotion-tshirts.jpg"
                        alt="T-Shirt Promotion">

                    <span class="product-label">30% OFF</span>

                </div>

                <div class="product-info">

                    <p class="product-category">T-Shirts</p>

                    <h3>Summer T-Shirt Sale</h3>

                    <p>
                        Get up to 30% off selected T-shirts.
                    </p>

                    <a href="tshirts.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


            <!-- Promotion 2 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="images/promotion-jackets.jpg"
                        alt="Jacket Promotion">

                    <span class="product-label">40% OFF</span>

                </div>

                <div class="product-info">

                    <p class="product-category">Jackets</p>

                    <h3>Jacket Special Offer</h3>

                    <p>
                        Save up to 40% on selected jackets.
                    </p>

                    <a href="jackets.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


            <!-- Promotion 3 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="images/promotion-jeans.jpg"
                        alt="Jeans Promotion">

                    <span class="product-label">25% OFF</span>

                </div>

                <div class="product-info">

                    <p class="product-category">Jeans</p>

                    <h3>Denim Days</h3>

                    <p>
                        Enjoy 25% off selected denim styles.
                    </p>

                    <a href="jeans.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


            <!-- Promotion 4 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="images/promotion-shoes.jpg"
                        alt="Shoes Promotion">

                    <span class="product-label">35% OFF</span>

                </div>

                <div class="product-info">

                    <p class="product-category">Shoes</p>

                    <h3>Step Into Savings</h3>

                    <p>
                        Get up to 35% off selected footwear.
                    </p>

                    <a href="shoes.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


            <!-- Promotion 5 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="images/promotion-accessories.jpg"
                        alt="Accessories Promotion">

                    <span class="product-label">20% OFF</span>

                </div>

                <div class="product-info">

                    <p class="product-category">Accessories</p>

                    <h3>Accessory Deals</h3>

                    <p>
                        Upgrade your style with 20% off accessories.
                    </p>

                    <a href="accessories.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


            <!-- Promotion 6 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="images/promotion-bags.jpg"
                        alt="Bags Promotion">

                    <span class="product-label">30% OFF</span>

                </div>

                <div class="product-info">

                    <p class="product-category">Bags</p>

                    <h3>Bag Collection Sale</h3>

                    <p>
                        Discover stylish bags at special prices.
                    </p>

                    <a href="bags.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


        </div>

    </section>


    <!-- Big Promotional Banner -->
    <section class="promo-banner">

        <div class="promo-content">

            <h2>MEGA FASHION SALE</h2>

            <p>
                Enjoy up to 50% OFF on selected fashion items.
            </p>

            <a href="salesandoffers.html" class="btn">
                Shop Sale
            </a>

        </div>

    </section>


    <!-- Special Offer -->
    <section class="products-section">

        <div class="section-title">

            <h2>Special Deals</h2>

            <p>
                Don't miss these limited-time promotional offers.
            </p>

        </div>


        <div class="product-grid">


            <div class="product-card">

                <div class="product-image">

                    <img src="images/buy-more-save-more.jpg"
                        alt="Buy More Save More">

                </div>

                <div class="product-info">

                    <p class="product-category">Special Offer</p>

                    <h3>Buy More, Save More</h3>

                    <p>
                        Buy 2 items and get 10% off.
                        Buy 3 or more and get 20% off.
                    </p>

                    <a href="collections.html" class="btn">
                        Explore Collection
                    </a>

                </div>

            </div>


            <div class="product-card">

                <div class="product-image">

                    <img src="images/free-shipping.jpg"
                        alt="Free Shipping">

                </div>

                <div class="product-info">

                    <p class="product-category">Free Shipping</p>

                    <h3>Free Delivery</h3>

                    <p>
                        Enjoy free shipping on qualifying orders.
                    </p>

                    <a href="collections.html" class="btn">
                        Start Shopping
                    </a>

                </div>

            </div>


            <div class="product-card">

                <div class="product-image">

                    <img src="images/new-member-offer.jpg"
                        alt="New Member Offer">

                    <span class="product-label">WELCOME</span>

                </div>

                <div class="product-info">

                    <p class="product-category">New Members</p>

                    <h3>Welcome Offer</h3>

                    <p>
                        New customers can enjoy an exclusive
                        welcome discount.
                    </p>

                    <a href="collections.html" class="btn">
                        Shop Now
                    </a>

                </div>

            </div>


        </div>

    </section>


    <!-- Newsletter -->
    <section class="newsletter">

        <div class="newsletter-content">

            <h2>Never Miss an Offer</h2>

            <p>
                Subscribe to our newsletter and receive the
                latest promotions, discounts and fashion updates.
            </p>

            <form class="newsletter-form">

                <input type="email"
                    placeholder="Enter your email address"
                    required>

                <button type="submit">
                    Subscribe
                </button>

            </form>

        </div>

    </section>


    <!-- Footer -->
    <footer class="footer">

        <div class="footer-container">


            <div class="footer-column">

                <h3>RAKESH DESIGNS</h3>

                <p>
                    Discover modern fashion, quality products
                    and stylish designs for every occasion.
                </p>

                <div class="social-icons">

                    <a href="#">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>

                    <a href="#">
                        <i class="fa-brands fa-instagram"></i>
                    </a>

                    <a href="#">
                        <i class="fa-brands fa-twitter"></i>
                    </a>

                    <a href="#">
                        <i class="fa-brands fa-youtube"></i>
                    </a>

                </div>

            </div>


            <div class="footer-column">

                <h3>Quick Links</h3>

                <a href="index.html">Home</a>
                <a href="aboutus.html">About Us</a>
                <a href="collections.html">Collections</a>
                <a href="salesandoffers.html">Sales & Offers</a>
                <a href="contactus.html">Contact Us</a>

            </div>


            <div class="footer-column">

                <h3>Collections</h3>

                <a href="tshirts.html">T-Shirts</a>
                <a href="jackets.html">Jackets</a>
                <a href="jeans.html">Jeans</a>
                <a href="shoes.html">Shoes</a>
                <a href="accessories.html">Accessories</a>
                <a href="bags.html">Bags</a>

            </div>


            <div class="footer-column">

                <h3>Contact</h3>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Singapore
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +65 1234 5678
                </p>

                <p>
                    <i class="fa-solid fa-envelope"></i>
                    info@rakeshdesigns.com
                </p>

            </div>


        </div>


        <div class="footer-bottom">

            <p>
                &copy; 2026 Rakesh Designs. All Rights Reserved.
            </p>

        </div>

    </footer>


    <script src="script.js"></script>

</body>

</html>
